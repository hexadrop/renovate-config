{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "renovate",
    "dependencies"
  ],
  "assigneesFromCodeOwners": true,
  "dependencyDashboard": true,
  "timezone": "Europe/Madrid",
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rebaseWhen": "automerging",
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com",
    "350309594+hexadrop[bot]@users.noreply.github.com"
  ],
  "packageRules": [
    {
      "description": "Automatically merge non-major devDependencies once the checks pass",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Require approval for patch updates of runtime dependencies: they produce a changeset",
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest"
      ],
      "automerge": false
    },
    {
      "description": "Require approval for minor updates of runtime dependencies: they produce a changeset",
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "minimumReleaseAge": "14 days",
      "automerge": false
    },
    {
      "description": "Automatically merge yarn, node and bun updates",
      "matchPackageNames": [
        "yarn",
        "node",
        "bun"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Automatically merge GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Do not wait for a cooldown on our own packages",
      "matchPackageNames": [
        "@hexadrop/**",
        "hexadrop/**"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Require explicit approval from the dependency dashboard for majors",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ],
    "minimumReleaseAge": null,
    "automerge": true
  }
}
